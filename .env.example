# Frontend environment variables template
# For local development, default (/api) forwards to http://localhost:5000 via vite.config.js proxy.
# For production deployment on Render Static Site, set VITE_API_BASE_URL to your backend URL:
# VITE_API_BASE_URL=https://rapidaid-api.onrender.com
VITE_API_BASE_URL=/api
VITE_API_URL=/api
