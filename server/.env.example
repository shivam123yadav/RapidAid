# RapidAid API server — copy to .env and adjust values
PORT=5000
HOST=0.0.0.0
# Cookie SameSite policy: lax (default / same-origin) or none (cross-origin with HTTPS)
COOKIE_SAME_SITE=lax
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/rapidaid

# Secrets: generate with `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
# Minimum 32 characters — the server refuses to boot with anything shorter.
JWT_ACCESS_SECRET=change-me-to-a-long-random-hex-string-at-least-32-chars
JWT_REFRESH_SECRET=change-me-to-another-long-random-hex-string-32-chars
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

# Comma-separated allowlist of browser origins permitted to call the API with credentials
CORS_ORIGINS=http://localhost:3000

# Seed demo data when the users collection is empty (idempotent, $setOnInsert).
# The demo accounts all share a known password, one of which is an Administrator,
# so the server REFUSES TO BOOT if this is true while NODE_ENV=production.
SEED_IF_EMPTY=true

LOG_LEVEL=info
# Set true to disable rate limiting (tests do this automatically via NODE_ENV)
RATE_LIMIT_DISABLED=false

# ── Road Routing & Dynamic ETA ──────────────────────────────────────────────
# Routing provider: 'osrm' (OSRM driving profile), 'mock' (deterministic test provider), or 'offline'
ROUTING_PROVIDER_TYPE=osrm
# Base URL for the OSRM routing server. Point to self-hosted or dedicated instance in production.
ROUTING_PROVIDER_URL=https://router.project-osrm.org
ROUTING_CACHE_TTL_MS=60000
ROUTING_RECALCULATION_DISTANCE_THRESHOLD_METERS=60
ROUTING_DEVIATION_THRESHOLD_METERS=100
ROUTING_TIMEOUT_MS=4000


# ── Metrics & Observability ──────────────────────────────────────────────────
# Dedicated Prometheus scraper endpoint (GET /metrics).
# Disabled by default in all environments. When enabled, requires a strong bearer
# token (at least 16 chars, not a placeholder) for `Authorization: Bearer <token>`.
METRICS_SCRAPE_ENABLED=false
METRICS_SCRAPE_TOKEN=


# ── Network & revocation tuning ──────────────────────────────────────────────
# Number of trusted reverse-proxy hops for deriving the client IP. Rate limiting
# keys on this value, so it MUST equal the real hop count. Set it to 0 unless the
# API genuinely sits behind a proxy: if it is trusted when it is not actually
# present, any client can rotate its rate-limit bucket by forging
# X-Forwarded-For. Use 1 behind the Vite dev proxy or a single load balancer.
TRUST_PROXY_HOPS=0

# How long a role's resolved permission set is cached in-process, in ms.
# 0 (the default, recommended) reads RolePolicy on every request so a permission
# revoked through the admin API takes effect immediately on every instance. A
# positive value trades revocation latency for fewer database reads and is only
# safe when running a single instance.
PERMISSION_CACHE_TTL_MS=0

# ── Email (verification & password reset) ──────────────────────────────
# console = write every message to the server log instead of sending it. The
# action link is printed in full, so both flows are fully exercisable with no
# provider account or API key. This is the default and suits local dev/CI.
# EMAIL_TRANSPORT options: console (default), brevo_api (Brevo transactional API), or smtp
EMAIL_TRANSPORT=console
# BREVO_API_KEY is required when EMAIL_TRANSPORT=brevo_api (e.g. xkeysib-...)
BREVO_API_KEY=
EMAIL_FROM=RapidAid <no-reply@rapidaid.com>
# Frontend base URL. Must match a route in src/App.tsx: the server builds
# `${PUBLIC_URL}/verify-email?token=…` and `${PUBLIC_URL}/reset-password?token=…`,
# so a wrong value sends people to a page that does not exist.
PUBLIC_URL=http://localhost:3000
# Lifetime of verification and password-reset links. 1-168.
EMAIL_TOKEN_TTL_HOURS=24

# ── SMTP (only read when EMAIL_TRANSPORT=smtp) ──────────────────────────
# The server refuses to boot on EMAIL_TRANSPORT=smtp without a host.
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=
EMAIL_SMTP_PASS=
# true = implicit TLS (port 465), which most providers require. Use false for
# STARTTLS on port 587.
EMAIL_SMTP_SECURE=true
