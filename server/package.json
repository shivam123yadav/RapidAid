{
  "name": "rapidaid-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "RapidAid backend — Express + TypeScript + MongoDB",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e:voice": "node scripts/e2e-voice-live.mjs",
    "verify:playback": "node scripts/verify-audio-playback.mjs",
    "verify:ui-flow": "node scripts/verify-voice-ui-flow.mjs",
    "seed": "tsx src/seed/runSeed.ts",
    "seed:gwalior": "tsx scripts/run-seed-gwalior.ts",
    "migrate:idempotency": "tsx scripts/migrate-idempotency-index.ts",
    "db:verify-indexes": "tsx scripts/verify-production-indexes.ts",
    "bootstrap:admin": "tsx scripts/bootstrap-admin.ts"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.5",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.13.0",
    "nodemailer": "^10.2.1",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "pino-pretty": "^13.0.0",
    "prom-client": "^15.1.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.7.5",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.15.0",
    "@types/nodemailer": "^8.0.2",
    "@types/supertest": "^6.0.3",
    "supertest": "^7.1.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.1.1"
  }
}
