# RapidAid V2 — Production Docker Compose Environment Template
# Copy this file to .env before starting the stack:
#   cp .env.docker.example .env

# ==============================================================================
# 1. MANDATORY DATABASE CREDENTIALS
# ==============================================================================
# The root user is used solely during initial MongoDB engine bootstrap.
# The application never runs as root; it authenticates using MONGO_APP_USERNAME.
# Passwords must be long, unpredictable random strings.
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=replace_with_strong_random_mongo_root_password_at_least_32_chars

# Dedicated, least-privilege RapidAid application database user
MONGO_APP_USERNAME=rapidaid_app
MONGO_APP_PASSWORD=replace_with_strong_random_mongo_app_password_at_least_32_chars

# ==============================================================================
# 2. MANDATORY APPLICATION SECRETS
# ==============================================================================
# HS256 JWT signing secrets. The backend server strictly refuses to boot if
# either secret is under 32 characters.
# Generate secure 64-character hex strings:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=replace_with_at_least_32_chars_random_hex_access_secret_key
JWT_REFRESH_SECRET=replace_with_at_least_32_chars_random_hex_refresh_secret_key

# ==============================================================================
# 3. PRODUCTION RUNTIME CONFIGURATION
# ==============================================================================
# In production, SEED_IF_EMPTY must be false. The server halts if true when NODE_ENV=production.
NODE_ENV=production
SEED_IF_EMPTY=false
TRUST_PROXY_HOPS=1
LOG_LEVEL=info

# Browser origins permitted to call the API with credentials (cookies)
CORS_ORIGINS=http://localhost:3000,http://localhost
PUBLIC_URL=http://localhost:3000
FRONTEND_PORT=3000

# ==============================================================================
# 4. OPTIONAL OBSERVABILITY (Phase 4.3.4)
# ==============================================================================
# Dedicated Prometheus scraper endpoint (GET /metrics).
# Disabled by default. When enabled, requires a strong bearer token (at least 16 chars).
METRICS_SCRAPE_ENABLED=false
METRICS_SCRAPE_TOKEN=

# ==============================================================================
# 5. DATABASE BACKUP & RECOVERY (Phase 4.4.3 & Phase 4.4.4)
# ==============================================================================
# Dedicated least-privilege read-only backup user on database 'rapidaid'.
# Note: Docker Compose initialization scripts (/docker-entrypoint-initdb.d) execute
# ONLY on initial creation of a new, empty data volume.
# For existing initialized MongoDB volumes, provision the backup user manually
# via administrative mongosh without resetting or recreating the volume:
#
#   docker exec -it rapidaid-mongo mongosh -u admin -p <ROOT_PASSWORD> --authenticationDatabase admin
#   const appDb = db.getSiblingDB('rapidaid');
#   if (!appDb.getUser('rapidaid_backup')) {
#     appDb.createUser({
#       user: 'rapidaid_backup',
#       pwd: '<REPLACE_WITH_STRONG_BACKUP_PASSWORD>',
#       roles: [{ role: 'read', db: 'rapidaid' }]
#     });
#   }
#
MONGO_BACKUP_USERNAME=rapidaid_backup
MONGO_BACKUP_PASSWORD=replace_with_strong_random_mongo_backup_password_at_least_32_chars

# Local backup destination directory (host filesystem path)
# OPERATIONAL NOTE: To prevent residual plaintext exposure from unlinked staging blocks,
# ensure BACKUP_DIR resides on an encrypted filesystem/volume (dm-crypt/LUKS or BitLocker).
BACKUP_DIR=./backups

# Retention period in days for daily tier (default: 7 daily, 4 weekly, 3 monthly)
BACKUP_RETENTION_DAYS=7

# Concurrency & Stale Lock Recovery:
# A backup lockfile (.backup.lock) prevents concurrent runs. If a backup process
# is forcibly killed, verify no node/mongodump process is active before removing:
#   rm ./backups/.backup.lock (or Remove-Item .\backups\.backup.lock)

# ------------------------------------------------------------------------------
# 5.1 ENCRYPTION, KEY LIFECYCLE & REGULATORY LIMITS (Phase 4.4.4)
# ------------------------------------------------------------------------------
# In production, backups are encrypted using AES-256-GCM by default.
# Generate a strong 256-bit (64-char hex) key:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# KEY ESCROW MANDATE:
# Escrow this key in a secure offline vault (e.g. AWS Secrets Manager, HashiCorp Vault,
# or offline HSM) before production use. If the key is lost, recovery sets encrypted
# under it are mathematically unrecoverable.
#
# KEY ROTATION POLICY:
# Each recovery set manifest records a cryptographic key identifier (keyId) derived
# via domain-separated hashing from the key. When rotating BACKUP_ENCRYPTION_KEY,
# historical keys must be archived and indexed by keyId in the escrow vault. The restore
# preflight verifies keyId before attempting decryption. Key rotation does not alter
# existing backup archives; historical recovery requires the key matching the manifest's keyId.
#
# HOST STORAGE ENCRYPTION & SCRATCH NOTICE:
# Standard filesystem unlinking does NOT cryptographically overwrite underlying flash/SSD
# memory blocks due to wear-leveling. Plaintext exists temporarily in restricted staging
# and restore scratch directories. The host volume hosting BACKUP_DIR and scratch paths
# MUST be encrypted at rest (e.g., dm-crypt/LUKS on Linux, BitLocker on Windows, or tmpfs).
#
# CROSS-VOLUME CONSISTENCY LIMITATIONS:
# Voice audio recordings and MongoDB documents reside on separate volumes without atomic
# distributed transactional snapshots. The backup pipeline captures voice storage read-only
# first, followed by the authenticated MongoDB dump (ordered asynchronous correlation).
# If a patient call completes mid-backup, an unreferenced audio file may be captured harmlessly.
# If any database record references a voice recording missing from the archive, the backup
# fails closed and will NOT publish a completed recovery set. Cross-volume atomic point-in-time
# consistency cannot be guaranteed without filesystem/storage-level unified snapshots.
#
# REGULATORY COMPLIANCE DISCLAIMER:
# Cryptographic protection (AES-256-GCM, HMAC-SHA256 authenticated manifests) provides
# necessary technical safeguards for data at rest and in transit. However, encryption alone
# does NOT establish or prove regulatory compliance (e.g., HIPAA Security Rule, GDPR Article 32,
# or SOC 2 Type II). Complete compliance requires formal governance, administrative policies,
# physical security, strict access controls, Business Associate Agreements (BAAs), audit trails,
# key escrow procedures, and regular authenticated restore verification drills.
BACKUP_ENCRYPTION_ENABLED=true
BACKUP_ENCRYPTION_KEY=replace_with_64_character_hex_encryption_key_at_least_32_bytes

# Strict safety flag: Disabling encryption is forbidden unless explicitly acknowledged:
ALLOW_UNENCRYPTED_BACKUPS=false

# Legacy Unencrypted Recovery Permission:
# By default, restoring legacy Phase 4.4.3 unencrypted backups is blocked (fails closed).
# Set to 'true' only to authorize historical drills of unencrypted recovery sets.
# Note: Enabling this flag NEVER bypasses authentication or decryption for Schema 2.0.0 sets.
RESTORE_UNENCRYPTED_ALLOWED=false

# ------------------------------------------------------------------------------
# 5.2 OFF-SITE REPLICATION (Scoped HTTPS Object Store Contract V1)
# ------------------------------------------------------------------------------
# Replicates encrypted recovery sets to an external HTTPS receiver.
# Keep disabled (false) until the remote receiver service is provisioned and verified.
OFFSITE_UPLOAD_ENABLED=false
OFFSITE_REMOTE_URL=https://backup-sink.internal.rapidaid.net/v1/backups
OFFSITE_API_TOKEN=replace_with_at_least_32_character_remote_api_token
# Optional custom CA PEM bundle path for internal PKI / self-signed receiver TLS:
OFFSITE_CA_BUNDLE=

# ------------------------------------------------------------------------------
# 5.3 ISOLATED RESTORE DRILL TARGET MANDATORY IDENTITIES (Phase 4.4.4)
# ------------------------------------------------------------------------------
# FAIL-CLOSED TARGET ISOLATION REQUIREMENT:
# In accordance with the mandatory restore safety gate, restore operations into
# disposable verification drill targets require explicit runtime identity parameters.
#
# CRITICAL SECURITY DIRECTIVE:
# Expected IDs MUST come from an independently inspected, explicitly provisioned
# disposable environment—they must NEVER be copied, scraped, or inferred from an
# unverified target during the restore operation itself.
# If any required expected identity is missing, empty, malformed, or mismatches
# runtime Docker inspection results, the restore utility immediately triggers a
# CRITICAL SAFETY ABORT before decryption, scratch-file creation, extraction,
# or destructive command execution.
#
DRILL_MONGO_HOST=mongo_drill
DRILL_NETWORK=net_drill
DRILL_VOICE_VOLUME=vol_drill_voice
DRILL_MONGO_USER=admin
DRILL_MONGO_PASSWORD=replace_with_drill_target_admin_password

# Mandatory Expected Target Identities (Validated against live Docker daemon & inspection):
DRILL_EXPECTED_CONTEXT=default
DRILL_EXPECTED_DAEMON_ID=replace_with_expected_daemon_id_from_docker_info
DRILL_EXPECTED_CONTAINER_ID=replace_with_expected_64_char_drill_container_id
DRILL_EXPECTED_NETWORK_ID=replace_with_expected_64_char_drill_network_id
DRILL_EXPECTED_MONGO_VOLUME_ID=vol_drill_mongo_data
DRILL_EXPECTED_VOICE_VOLUME_ID=vol_drill_voice
# Optional: Legitimate owner container ID if a voice service is actively running:
DRILL_EXPECTED_VOICE_CONTAINER_ID=

# Operating-system scheduler invocation examples:
# Linux Cron (Daily at 02:00 AM):
#   0 2 * * * cd /path/to/rapidaid && node scripts/backup-db.mjs >> /var/log/rapidaid-backup.log 2>&1
# Windows Task Scheduler (Daily at 02:00 AM):
#   schtasks /create /tn "RapidAid Daily Backup" /tr "node C:\path\to\rapidaid\scripts\backup-db.mjs" /sc daily /st 02:00

