# ==============================================================================
# RapidAid Production Environment Configuration Template
# ==============================================================================
# INSTRUCTIONS:
# 1. Copy this file to `.env.production` on your secure deployment host or inject
#    these variables via your secret manager (e.g. AWS Secrets Manager, Doppler, Vault).
# 2. NEVER commit actual production credentials to source control.
# 3. Minimum 32-character cryptographically random secrets MUST be generated for JWT tokens:
#      openssl rand -hex 32
# ==============================================================================

# Runtime Environment (enforces fail-fast safety checks)
NODE_ENV=production
PORT=5000
HOST=0.0.0.0

# Database Configuration (MongoDB Atlas or Production Replica Set)
# NOTE: Production will refuse to start if MONGODB_URI points to rapidaid_phase1_test or any test database.
MONGODB_URI=mongodb+srv://<app_username>:<strong_password>@<cluster-address>.mongodb.net/rapidaid?retryWrites=true&w=majority&maxPoolSize=50&minPoolSize=5

# Reverse Proxy & Networking
# Set to 1 if behind Nginx or an AWS ALB / Cloudflare ingress reverse proxy
TRUST_PROXY_HOPS=1

# Strict Production CORS Origin Allowlist (Comma-separated, no wildcards allowed in production)
CORS_ORIGINS=https://rapidaid.yourdomain.com
PUBLIC_URL=https://rapidaid.yourdomain.com
COOKIE_SAME_SITE=lax

# Cryptographic Authentication Secrets (Min 32 characters, no placeholders permitted)
# Generate with: openssl rand -hex 32
JWT_ACCESS_SECRET=REPLACE_WITH_SECURE_RANDOM_HEX_64_CHARACTERS_ACCESS
JWT_REFRESH_SECRET=REPLACE_WITH_SECURE_RANDOM_HEX_64_CHARACTERS_REFRESH
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

# Operational & Safety Controls
# CRITICAL SAFETY REQUIREMENT: Automated dispatch MUST remain false.
# Ambulance assignments strictly require human dispatcher confirmation.
AUTOMATED_DISPATCH_ENABLED=false

# Database Seeding (Must be false in production; startup aborts if set to true)
SEED_IF_EMPTY=false
RATE_LIMIT_DISABLED=false
LOG_LEVEL=info

# Road Routing Engine Configuration
# For production, point to a self-hosted OSRM container or dedicated routing service.
# Do NOT rely on the public project-osrm.org demo endpoint for production traffic.
ROUTING_PROVIDER_TYPE=osrm
ROUTING_PROVIDER_URL=http://osrm-backend:5000
ROUTING_CACHE_TTL_MS=60000
ROUTING_RECALCULATION_DISTANCE_THRESHOLD_METERS=60
ROUTING_DEVIATION_THRESHOLD_METERS=100
ROUTING_TIMEOUT_MS=4000

# Telemetry Configuration
TELEMETRY_FRESHNESS_THRESHOLD_SECONDS=300

# Observability & Prometheus Metrics
# Protected by Bearer token; set to true if an internal Prometheus scraper is configured.
METRICS_SCRAPE_ENABLED=false
METRICS_SCRAPE_TOKEN=

# Production Email Service (Brevo Transactional Email API over HTTPS)
# Resolves SMTP connection timeouts on cloud platforms (e.g. Render).
EMAIL_TRANSPORT=brevo_api
BREVO_API_KEY=xkeysib-REPLACE_WITH_YOUR_BREVO_API_KEY
EMAIL_FROM=RapidAid Emergency Dispatch <alerts@rapidaid.yourdomain.com>
EMAIL_TOKEN_TTL_HOURS=24

# Optional SMTP fallback configuration (only read when EMAIL_TRANSPORT=smtp)
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=
EMAIL_SMTP_PASS=
EMAIL_SMTP_SECURE=true


# Production SMS Service (Twilio)
# When configured, urgent citizen and crew SMS alerts are dispatched via Twilio REST API.
# When missing, delivery falls back safely to MOCK_DELIVERED with honest logging.
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+15551234567

# Web Push Notification Service (VAPID)
# Generate VAPID keypair with: npx web-push generate-vapid-keys
WEB_PUSH_ENABLED=false
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:sysadmin@rapidaid.yourdomain.com

# Map Tile Provider
MAP_TILE_PROVIDER_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
MAP_TILE_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors
